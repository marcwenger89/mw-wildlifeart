---
// Startanimation: Das Logo baut sich Buchstabe für Buchstabe auf, dann öffnet sich die Seite.
// Läuft nur beim ersten Aufruf pro Besuch und nie bei «Bewegung reduzieren».
interface Props { name: string }
const [vorname, ...rest] = Astro.props.name.split('-');
const nachname = rest.join('-');
let i = 0;
const buchstaben = (text: string) => [...text].map(z => ({ z, i: i++ }));
const teil1 = buchstaben(vorname);
const strich = i++;
const teil2 = buchstaben(nachname);
---
<script is:inline>
  try {
    if (!sessionStorage.getItem('mw-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('intro-an');
    }
  } catch (e) {}
</script>
<div class="intro" id="intro" aria-hidden="true">
  <div class="intro-logo">
    {teil1.map(b => <span class="intro-z" style={`--i:${b.i}`}>{b.z}</span>)}
    {nachname && <em class="intro-strich" style={`--i:${strich}`}>-</em>}
    {teil2.map(b => <span class="intro-z" style={`--i:${b.i}`}>{b.z}</span>)}
  </div>
  <span class="intro-linie"></span>
  <span class="intro-sub">Wildtierfotografie · Schweiz</span>
</div>

<style is:global>
  .intro { display: none; }
  html.intro-an { overflow: hidden; }
  html.intro-an .intro {
    position: fixed; inset: 0; z-index: 200; background: var(--bg);
    display: grid; place-content: center; justify-items: center; gap: 18px;
    clip-path: inset(0 0 0 0);
    animation: intro-weg 900ms var(--ease) 2300ms forwards;
  }
  html.intro-an .site-head .logo { opacity: 0; }
  html.intro-fertig .site-head .logo { opacity: 1; transition: opacity 600ms var(--ease); }
  .intro-logo {
    font-family: var(--f-display); font-weight: 300; letter-spacing: -.02em; line-height: 1;
    font-size: clamp(2.6rem, 9vw, 6rem); white-space: nowrap; color: var(--fg);
  }
  .intro-z, .intro-strich {
    display: inline-block; opacity: 0; transform: translateY(.45em); filter: blur(6px);
    animation: intro-z 800ms var(--ease) forwards; animation-delay: calc(200ms + var(--i) * 55ms);
  }
  .intro-strich { font-style: italic; color: var(--accent); }
  .intro-linie {
    display: block; width: min(320px, 50vw); height: 1px; background: var(--accent);
    transform: scaleX(0); animation: intro-linie 1000ms var(--ease) 900ms forwards;
  }
  .intro-sub {
    font: 500 .75rem/1.2 var(--f-mono); letter-spacing: .24em; text-transform: uppercase; color: var(--muted);
    opacity: 0; animation: intro-ein 800ms var(--ease) 1300ms forwards;
  }
  @keyframes intro-z { to { opacity: 1; transform: none; filter: none; } }
  @keyframes intro-linie { to { transform: scaleX(1); } }
  @keyframes intro-ein { to { opacity: 1; } }
  @keyframes intro-weg { to { clip-path: inset(0 0 100% 0); } }
</style>

<script>
  const html = document.documentElement;
  if (html.classList.contains('intro-an')) {
    const intro = document.getElementById('intro')!;
    const ende = () => {
      html.classList.remove('intro-an');
      html.classList.add('intro-fertig');
      try { sessionStorage.setItem('mw-intro', '1'); } catch (e) {}
    };
    intro.addEventListener('animationend', e => { if (e.animationName === 'intro-weg') ende(); });
    // Klick oder Taste überspringt die Animation
    const skip = () => ende();
    intro.addEventListener('click', skip);
    addEventListener('keydown', skip, { once: true });
    setTimeout(ende, 4000); // Sicherheitsnetz
  }
</script>

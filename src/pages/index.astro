---
import Seite from '../layouts/Seite.astro';
import Kontaktformular from '../components/Kontaktformular.astro';
import Werke from '../components/Werke.astro';
import einstellungen from '../data/einstellungen.json';
import { getCollection } from 'astro:content';
import { alleFotos, alleBeitraege, datumCH } from '../lib/inhalt';

const s = einstellungen.startseite;
const fotos = await alleFotos();
// «Begegnungen»: angehakte Fotos zuerst (neueste zuerst), dann mit den neuesten übrigen auf 6 auffüllen.
const neueste = [...fotos].sort((a, b) => (b.data.hochgeladen?.getTime() ?? 0) - (a.data.hochgeladen?.getTime() ?? 0));
const werke = [...neueste.filter(f => f.data.werk), ...neueste.filter(f => !f.data.werk)].slice(0, 6);
const heroFotos = (() => { const h = fotos.filter(f => f.data.startseite); return h.length ? h : fotos.slice(0, 3); })();
const shopAktiv = einstellungen.shop.aktiv;
const shop = (await getCollection('shop')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const beitraege = (await alleBeitraege()).slice(0, 3);
const ueber = einstellungen.ueber_mich;
const absaetze = (t: string) => t.split(/\n\s*\n/).filter(Boolean);
---
<Seite bild={heroFotos[0]?.data.bild}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-frame" id="hero">
        {heroFotos.map((f, i) => (
          <picture>
            {f.data.startbild_handy && <source media="(max-width: 640px)" srcset={f.data.startbild_handy}>}
            <img src={f.data.startbild ?? f.data.bild} alt={f.data.titel} class={i === 0 ? 'on instant' : undefined}
                 style={`object-position: ${f.data.ausschnitt}`}
                 loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined}
                 data-titel={f.data.titel} data-ort={f.data.ort ?? ''} data-link={`/galerien/${f.data.serie.id}/?bild=${f.id}`}>
          </picture>
        ))}
        <a class="hero-link" id="hero-link" href={`/galerien/${heroFotos[0]?.data.serie.id}/?bild=${heroFotos[0]?.id}`} aria-label={`Foto ansehen: ${heroFotos[0]?.data.titel}`}></a>
        {heroFotos.length > 1 && <>
          <button type="button" class="hero-pfeil zurueck" id="hero-zurueck" aria-label="Vorheriges Bild"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg></button>
          <button type="button" class="hero-pfeil weiter" id="hero-weiter" aria-label="Nächstes Bild"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg></button>
        </>}
        {heroFotos.length > 1 && (
          <div class="hero-caption">
            <div class="hero-dots" id="hero-dots" aria-label="Bild wählen">
              {heroFotos.map((_, i) => <button type="button" aria-label={`Bild ${i + 1}`} class={i === 0 ? 'on' : undefined}></button>)}
            </div>
          </div>
        )}
      </div>
      <div class="hero-text">
        <h1>{s.titel} {s.titel_betont && <em>{s.titel_betont}</em>} {s.titel_ende}</h1>
        <div>
          <p>{s.text}</p>
          <div class="btn-row">
            <a class="btn primary" href="#werke">Galerien ansehen</a>
            {shopAktiv
              ? <a class="btn" href="#shop">Prints und Kalender</a>
              : <a class="btn" href="#ueber">Über mich</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  {werke.length > 0 && (
  <section class="block" id="werke">
    <div class="wrap">
      <div class="block-head">
        <h2>{s.werke_titel || 'Begegnungen'}</h2>
      </div>
      <Werke fotos={werke} />
      <div class="werke-fuss"><a class="btn" href="/galerien/">{s.werke_knopf || 'Alle Galerien'} <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
  )}

  {shopAktiv && (
  <section class="block" id="shop">
    <div class="wrap">
      <div class="block-head">
        <div>
          <p class="eyebrow">Shop</p>
          <h2>{s.shop_titel}</h2>
        </div>
        <p>{s.shop_text}</p>
      </div>
      <div class="shop">
        {shop.map(p => (
          <div class="product">
            <div class="ph"><img src={p.data.bild} alt="" loading="lazy"></div>
            <h3>{p.data.titel}</h3>
            <p>{p.data.beschreibung}</p>
            {p.data.angaben.length > 0 && <dl>{p.data.angaben.map(a => <><dt>{a.bezeichnung}</dt><dd>{a.wert}</dd></>)}</dl>}
            <div><a class="btn" href={p.data.saal_link} target="_blank" rel="noopener">{p.data.knopf_text}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12"/></svg></a></div>
          </div>
        ))}
      </div>
      <p class="saal-note">{einstellungen.saal_hinweis}</p>
    </div>
  </section>
  )}

  {beitraege.length > 0 && (
    <section class="block" id="blog">
      <div class="wrap">
        <div class="block-head">
          <div>
            <p class="eyebrow">Blog</p>
            <h2>Aus dem Feld</h2>
          </div>
          <a class="btn" href="/blog/">Alle Beiträge</a>
        </div>
        <div class="posts">
          {beitraege.map(p => (
            <a class="post" href={`/blog/${p.id}/`}>
              {p.data.bild && <div class="ph"><img src={p.data.bild} alt="" loading="lazy"></div>}
              <span class="mono" style="color:var(--muted)">{datumCH(p.data.datum)}</span>
              <h3>{p.data.titel}</h3>
              <p>{p.data.kurztext}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="block" id="ueber">
    <div class="wrap about">
      <div>
        <p class="eyebrow">Über mich</p>
        <h2>{ueber.titel}</h2>
        {absaetze(ueber.text).map(t => <p>{t}</p>)}
        {ueber.link && <a class="btn" href={ueber.link}>{ueber.knopf_text || 'Mehr über mich'}</a>}
        {ueber.bild && <img class="portrait" src={ueber.bild} alt="Porträt" loading="lazy">}
      </div>
      <div id="kontakt">
        <p class="eyebrow">Kontakt</p>
        <h2>{einstellungen.kontakt.titel}</h2>
        <p>{einstellungen.kontakt.text}</p>
        <Kontaktformular />
      </div>
    </div>
  </section>
</Seite>

<script>
  // Hero: Bilder überblenden, bei «Bewegung reduzieren» kein automatischer Wechsel
  const hero = document.getElementById('hero');
  if (hero) {
    const imgs = [...hero.querySelectorAll<HTMLImageElement>('img')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('#hero-dots button')];
    const link = document.getElementById('hero-link') as HTMLAnchorElement;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0, timer: number | undefined;
    requestAnimationFrame(() => requestAnimationFrame(() => imgs[0]?.classList.remove('instant')));
    const show = (k: number) => {
      idx = k;
      imgs.forEach((el, i) => el.classList.toggle('on', i === k));
      dots.forEach((b, i) => b.classList.toggle('on', i === k));
      const d = imgs[k].dataset;
      link.href = d.link!;
      link.setAttribute('aria-label', 'Foto ansehen: ' + d.titel);
    };
    const restart = () => {
      clearInterval(timer);
      if (!calm && imgs.length > 1) timer = window.setInterval(() => show((idx + 1) % imgs.length), 6500);
    };
    dots.forEach((b, i) => b.addEventListener('click', () => { show(i); restart(); }));
    const schritt = (dir: number) => { show((idx + dir + imgs.length) % imgs.length); restart(); };
    document.getElementById('hero-zurueck')?.addEventListener('click', () => schritt(-1));
    document.getElementById('hero-weiter')?.addEventListener('click', () => schritt(1));
    // Wischen am Handy
    let tx: number | null = null, ty = 0;
    hero.addEventListener('touchstart', e => { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, { passive: true });
    hero.addEventListener('touchend', e => {
      if (tx === null || imgs.length < 2) return;
      const dx = e.changedTouches[0].clientX - tx, dy = e.changedTouches[0].clientY - ty;
      tx = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) schritt(dx < 0 ? 1 : -1);
    });
    restart();
  }
</script>

---
import Seite from '../layouts/Seite.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('seiten')).map(s => ({ params: { seite: s.id }, props: { eintrag: s } }));
}
const { eintrag } = Astro.props;
const { Content } = await render(eintrag);
---
<Seite titel={eintrag.data.titel} immerOffen>
  <article class="text-page">
    <div class="wrap prose">
      <h1>{eintrag.data.titel}</h1>
      <Content />
    </div>
  </article>
</Seite>

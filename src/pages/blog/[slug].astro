---
import Seite from '../../layouts/Seite.astro';
import { alleBeitraege, datumCH } from '../../lib/inhalt';
import { einfachesMarkdown } from '../../lib/text';
import Teilen from '../../components/Teilen.astro';

export async function getStaticPaths() {
  return (await alleBeitraege()).map(p => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
---
<Seite titel={post.data.titel} beschreibung={post.data.kurztext} bild={post.data.bild} artikel>
  <article class="text-page">
    <div class="wrap">
      <nav class="crumbs" aria-label="Pfad"><a href="/">Startseite</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a></nav>
      {post.data.bild && post.data.kopfbild && <img class="post-hero" src={post.data.bild} alt="">}
      <div class="prose">
        <p class="eyebrow">{datumCH(post.data.datum)}</p>
        <h1>{post.data.titel}</h1>
        <Fragment set:html={einfachesMarkdown(post.body)} />
      </div>
      {post.data.abschnitte.map(a => (
        <section class:list={['abschnitt', a.schrift !== 'standard' && `schrift-${a.schrift}`, a.farbe !== 'standard' && `farbe-${a.farbe}`, a.bilder.length > 0 && ['mit-bild', a.bildseite, a.bildseite !== 'unten' && a.bildbreite < 40 && 'schmal', a.bildseite !== 'unten' && a.bildhoehe === 'text' && 'texthoehe']]}
                 style={a.bilder.length > 0 ? `--bildbreite: ${a.bildbreite}%` : undefined}>
          <div class="prose" set:html={einfachesMarkdown(a.text)} />
          {a.bilder.length > 0 && (
            <div class="abschnitt-bilder">
              {a.bilder.map(b => <img class:list={[b.format, b.breite]} src={b.bild} alt={b.alt} loading="lazy">)}
            </div>
          )}
        </section>
      ))}
      <Teilen titel={post.data.titel} url={new URL(`/blog/${post.id}/`, Astro.site).href} />
    </div>
  </article>
</Seite>

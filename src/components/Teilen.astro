---
// Teilen-Knopf für Blogbeiträge: ein Knopf, der direkt das Teilen-Menü des Geräts öffnet
// (Handy: Instagram, WhatsApp, Mail usw. – jeder wählt selbst). Gibt es kein Teilen-Menü
// (z. B. Firefox am PC), wird der Link kopiert. Keine fremden Skripte oder Cookies (DSG-freundlich).
interface Props { titel: string; url: string }
const { titel, url } = Astro.props;
---
<div class="teilen" data-titel={titel} data-url={url}>
  <button type="button" class="teilen-knopf teilen-haupt">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 15V3M7.5 7.5 12 3l4.5 4.5M5 12v7.5h14V12"/></svg>
    <span class="teilen-name">Teilen</span>
  </button>
  <p class="teilen-hinweis" hidden aria-live="polite"></p>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.teilen')) {
    const url = box.dataset.url!;
    const titel = box.dataset.titel || document.title;
    const knopf = box.querySelector<HTMLButtonElement>('.teilen-haupt')!;
    const name = knopf.querySelector<HTMLElement>('.teilen-name')!;
    const hinweis = box.querySelector<HTMLElement>('.teilen-hinweis')!;
    let timer = 0;
    const kopieren = async () => {
      try { await navigator.clipboard.writeText(url); } catch {
        const f = document.createElement('textarea'); f.value = url; document.body.append(f); f.select();
        try { document.execCommand('copy'); } catch {}
        f.remove();
      }
      name.textContent = 'Link kopiert ✓'; knopf.classList.add('ok');
      hinweis.textContent = 'Der Link ist kopiert und kann jetzt überall eingefügt werden.'; hinweis.hidden = false;
      clearTimeout(timer);
      timer = window.setTimeout(() => { name.textContent = 'Teilen'; knopf.classList.remove('ok'); hinweis.hidden = true; }, 4000);
    };
    knopf.addEventListener('click', async () => {
      if (typeof navigator.share === 'function') {
        try { await navigator.share({ title: titel, text: titel, url }); return; }
        catch (e) { if ((e as DOMException)?.name === 'AbortError') return; }
      }
      kopieren();
    });
  }
</script>

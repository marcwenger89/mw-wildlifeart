---
import type { CollectionEntry } from 'astro:content';
import { seitenverhaeltnis } from '../lib/bildgroesse';
interface Props { fotos: CollectionEntry<'fotos'>[]; von: string; art?: 'spalten' | 'reihen' | 'raster' }
const { fotos, von, art = 'reihen' } = Astro.props;
---
<div class={`mosaic mosaic-${art}`} data-art={art}>
  {fotos.map(f => (
    <a class="tile" href={`/fotos/${f.id}/?von=${von}`} data-tags={f.data.tags.join('|')} style={`--r: ${(seitenverhaeltnis(f.data.bild) ?? 1.5).toFixed(4)}`}>
      <img src={f.data.bild} alt={f.data.titel} loading="lazy">
      <span class="cap"><strong>{f.data.titel}</strong>{f.data.ort && <span>{f.data.ort}</span>}</span>
    </a>
  ))}
</div>

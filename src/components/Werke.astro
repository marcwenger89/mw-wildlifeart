---
import type { CollectionEntry } from 'astro:content';
import { bildText, galerieTitel } from '../lib/inhalt';
interface Props { fotos: CollectionEntry<'fotos'>[] }
const galerien = await galerieTitel();
const { fotos } = Astro.props;
---
<div class="werke">
  {fotos.map(f => (
    <a class="werk" href={`/galerien/${f.data.serie.id}/?bild=${f.id}`} aria-label={`${f.data.titel}: im Vollbild ansehen`}>
      <img src={f.data.werkbild ?? f.data.bild} alt={bildText(f.data, galerien.get(f.data.serie.id))} loading="lazy">
    </a>
  ))}
</div>

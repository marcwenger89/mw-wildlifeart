---
// Teilen-Leiste für Blogbeiträge: Instagram, Facebook, Link kopieren.
// Nur einfache Links, keine fremden Skripte oder Cookies (DSG-freundlich).
// Instagram kennt keinen Teilen-Link fürs Web: Am Handy öffnet der Knopf das Teilen-Menü des Geräts
// (dort Instagram wählen), am PC wird der Link kopiert, damit man ihn in Instagram einfügen kann.
interface Props { titel: string; url: string }
const { titel, url } = Astro.props;
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
---
<div class="teilen" data-titel={titel} data-url={url}>
  <button type="button" class="teilen-knopf teilen-haupt" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 15V3M7.5 7.5 12 3l4.5 4.5M5 12v7.5h14V12"/></svg>
    <span>Teilen</span>
    <svg class="teilen-pfeil" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 3.5 5 6.5l3-3"/></svg>
  </button>
  <div class="teilen-knoepfe" role="menu">
    <button type="button" class="teilen-knopf teilen-insta" role="menuitem" title="Auf Instagram teilen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".9" fill="currentColor" stroke="none"/></svg>
      <span class="teilen-name">Instagram</span>
    </button>
    <a class="teilen-knopf teilen-fb" role="menuitem" href={facebook} target="_blank" rel="noopener" title="Auf Facebook teilen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5Z"/></svg>
      <span class="teilen-name">Facebook</span>
    </a>
    <button type="button" class="teilen-knopf teilen-kopieren" role="menuitem" title="Link kopieren">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3.5-3.5a4 4 0 0 0-5.7-5.7L12 6.3"/><path d="M14 10a4 4 0 0 0-5.7 0l-3.5 3.5a4 4 0 0 0 5.7 5.7l1.5-1.5"/></svg>
      <span class="teilen-name">Link kopieren</span>
    </button>
  </div>
  <p class="teilen-hinweis" hidden aria-live="polite"></p>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.teilen')) {
    const titel = box.dataset.titel!, url = box.dataset.url!;
    const hinweis = box.querySelector<HTMLElement>('.teilen-hinweis')!;
    // Aufklapp-Menü: Klick auf «Teilen» öffnet/schliesst, Klick daneben oder Escape schliesst
    const haupt = box.querySelector<HTMLButtonElement>('.teilen-haupt')!;
    const setOffen = (offen: boolean) => { box.classList.toggle('offen', offen); haupt.setAttribute('aria-expanded', String(offen)); };
    haupt.addEventListener('click', e => { e.stopPropagation(); setOffen(!box.classList.contains('offen')); });
    document.addEventListener('click', e => { if (!box.contains(e.target as Node)) setOffen(false); });
    box.addEventListener('keydown', e => { if (e.key === 'Escape') { setOffen(false); haupt.focus(); } });
    let timer = 0;
    const melden = (knopf: HTMLElement, text: string, lang = '') => {
      const name = knopf.querySelector('.teilen-name')!;
      const alt = name.textContent;
      name.textContent = text; knopf.classList.add('ok');
      hinweis.textContent = lang; hinweis.hidden = !lang;
      clearTimeout(timer);
      timer = window.setTimeout(() => { name.textContent = alt; knopf.classList.remove('ok'); hinweis.hidden = true; }, lang ? 5000 : 2000);
    };
    const kopieren = async () => {
      try { await navigator.clipboard.writeText(url); } catch {
        const f = document.createElement('textarea'); f.value = url; document.body.append(f); f.select();
        try { document.execCommand('copy'); } catch {}
        f.remove();
      }
    };
    const kopierKnopf = box.querySelector<HTMLButtonElement>('.teilen-kopieren')!;
    kopierKnopf.addEventListener('click', async () => { await kopieren(); melden(kopierKnopf, 'Kopiert ✓'); setTimeout(() => setOffen(false), 1200); });
    box.querySelector('.teilen-fb')!.addEventListener('click', () => setOffen(false));
    const insta = box.querySelector<HTMLButtonElement>('.teilen-insta')!;
    insta.addEventListener('click', async () => {
      // Handy: Teilen-Menü des Geräts, dort Instagram wählen
      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        setOffen(false);
        navigator.share({ title: titel, url }).catch(() => {});
        return;
      }
      await kopieren();
      melden(insta, 'Link kopiert ✓', 'Link kopiert. Füge ihn in Instagram in deine Story, einen Beitrag oder eine Nachricht ein.');
      setOffen(false);
    });
  }
</script>
